generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                               BigInt                             @id @default(autoincrement())
  password                         String                             @db.VarChar(128)
  last_login                       DateTime?                          @db.DateTime(6)
  is_superuser                     Boolean
  email                            String                             @unique(map: "email") @db.VarChar(254)
  firstName                        String                             @map("first_name") @db.VarChar(30)
  lastName                         String                             @map("last_name") @db.VarChar(30)
  role                             String                             @db.VarChar(20)
  isStaff                          Boolean                            @map("is_staff")
  isActive                         Boolean                            @map("is_active")
  dateJoined                       DateTime                           @map("date_joined") @db.DateTime(6)
  updatedAt                        DateTime                           @updatedAt @map("updated_at") @db.DateTime(6)
  isVerified                       Boolean                            @map("is_verified")
  city                             String                             @db.VarChar(100)
  state                            String                             @db.VarChar(100)
  zipCode                          Int                                @map("zip_code")
  country                          String                             @db.VarChar(100)
  address1                         String                             @db.LongText
  address2                         String                             @db.LongText
  securityQuestion                 String                             @map("security_question") @db.VarChar(255)
  securityAnswer                   String                             @map("security_answer") @db.VarChar(255)
  profileImage                     String?                            @map("profile_image") @db.VarChar(100)
  phoneNumber                      String?                            @map("phone_number") @db.VarChar(15)
  summery                          String?                            @map("summery") @db.LongText
  api_blogcategory                 BlogCategory[]
  blogPosts                        BlogPost[]                         @relation("AuthorPosts")
  api_blogtag                      BlogTag[]
  api_uploadedimage                UploadedImage[]
  api_userprofile_groups           api_userprofile_groups[]
  api_userprofile_user_permissions api_userprofile_user_permissions[]
  django_admin_log                 django_admin_log[]

  @@map("api_userprofile")
}

model BlogCategory {
  id              BigInt      @id @default(autoincrement())
  name            String      @unique(map: "name") @db.VarChar(100)
  slug            String      @unique(map: "slug") @db.VarChar(100)
  count           Int
  description     String?     @db.LongText
  created_by_id   BigInt
  api_userprofile UserProfile @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_blogcategory_created_by_id_446c447f_fk_api_userprofile_id")
  posts           BlogPost[]  @relation("CategoryPosts")

  @@index([created_by_id], map: "api_blogcategory_created_by_id_446c447f_fk_api_userprofile_id")
  @@map("api_blogcategory")
}

model BlogTag {
  id                BigInt              @id @default(autoincrement())
  name              String              @unique(map: "name") @db.VarChar(100)
  slug              String              @unique(map: "slug") @db.VarChar(100)
  count             Int
  created_by_id     BigInt
  api_blogpost_tags api_blogpost_tags[]
  api_userprofile   UserProfile         @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_blogtag_created_by_id_6c5fff68_fk_api_userprofile_id")

  @@index([created_by_id], map: "api_blogtag_created_by_id_6c5fff68_fk_api_userprofile_id")
  @@map("api_blogtag")
}

model BlogMainPageSections {
  id        BigInt     @id @default(autoincrement())
  section   String?    @db.VarChar(255)
  createdAt DateTime?  @map("created_at") @db.DateTime(6)
  posts     BlogPost[] @relation("BlogMainPageSections")

  @@map("api_blogmainpagesections")
}

model UploadedImage {
  id               BigInt      @id @default(autoincrement())
  name             String?     @db.VarChar(255)
  image            String      @db.VarChar(100)
  size             Float
  contentType      String?     @map("content_type") @db.VarChar(12)
  width            Int
  height           Int
  thumbnail        String?     @db.VarChar(100)
  uploadedAt       DateTime    @map("uploaded_at") @db.DateTime(6)
  status           String      @db.VarChar(10)
  notificationSent Boolean     @map("notification_sent")
  uploaded_by_id   BigInt
  blog_url         String?     @db.VarChar(1000)
  api_userprofile  UserProfile @relation(fields: [uploaded_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_uploadedimage_uploaded_by_id_9c17db36_fk_api_userprofile_id")

  @@index([uploaded_by_id], map: "api_uploadedimage_uploaded_by_id_9c17db36_fk_api_userprofile_id")
  @@map("api_uploadedimage")
}

model BlogPost {
  id                BigInt                @id @default(autoincrement())
  title             String                @unique(map: "title") @db.VarChar(255)
  slug              String                @unique(map: "slug") @db.VarChar(255)
  content           String                @db.LongText
  excerpt           String?               @db.LongText
  featuredImage     String?               @map("featured_image") @db.VarChar(1000)
  blogFeaturedImage String?               @map("blog_featured_image") @db.VarChar(1000)
  createdAt         DateTime              @map("created_at") @db.DateTime(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.DateTime(6)
  publishedAt       DateTime?             @map("published_at") @db.DateTime(6)
  status            String                @db.VarChar(10)
  metaTitle         String?               @map("meta_title") @db.VarChar(500)
  metaDescription   String?               @map("meta_description") @db.LongText
  keywords          String?               @db.LongText
  viewCount         Int                   @map("view_count")
  likeCount         Int                   @map("like_count")
  isApproved        Boolean               @map("is_approved")
  isFeatured        Boolean               @map("is_featured")
  author_id         BigInt
  blog_like_id      BigInt?
  category_id       BigInt?
  blog_section_id   BigInt?
  author            UserProfile           @relation("AuthorPosts", fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_blogpost_author_id_9c4e6bfb_fk_api_userprofile_id")
  api_bloglikes     api_bloglikes?        @relation(fields: [blog_like_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_blogpost_blog_like_id_0143d3cf_fk_api_bloglikes_id")
  section           BlogMainPageSections? @relation("BlogMainPageSections", fields: [blog_section_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_blogpost_blog_section_id_6cc972d5_fk_api_blogm")
  category          BlogCategory?         @relation("CategoryPosts", fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_blogpost_category_id_332167cd_fk_api_blogcategory_id")
  api_blogpost_tags api_blogpost_tags[]

  @@index([author_id], map: "api_blogpost_author_id_9c4e6bfb_fk_api_userprofile_id")
  @@index([blog_like_id], map: "api_blogpost_blog_like_id_0143d3cf_fk_api_bloglikes_id")
  @@index([blog_section_id], map: "api_blogpost_blog_section_id_6cc972d5_fk_api_blogm")
  @@index([category_id], map: "api_blogpost_category_id_332167cd_fk_api_blogcategory_id")
  @@map("api_blogpost")
}

model api_bloglikes {
  id           BigInt     @id @default(autoincrement())
  blog_like    Int?
  blog_dislike Int?
  created_at   DateTime?  @db.DateTime(6)
  api_blogpost BlogPost[]
}

model api_blogpost_tags {
  id           BigInt   @id @default(autoincrement())
  blogpost_id  BigInt
  blogtag_id   BigInt
  api_blogpost BlogPost @relation(fields: [blogpost_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_blogpost_tags_blogpost_id_174c07ec_fk_api_blogpost_id")
  api_blogtag  BlogTag  @relation(fields: [blogtag_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_blogpost_tags_blogtag_id_eb76e857_fk_api_blogtag_id")

  @@unique([blogpost_id, blogtag_id], map: "api_blogpost_tags_blogpost_id_blogtag_id_e712cadb_uniq")
  @@index([blogtag_id], map: "api_blogpost_tags_blogtag_id_eb76e857_fk_api_blogtag_id")
}

model api_userprofile_groups {
  id              BigInt      @id @default(autoincrement())
  userprofile_id  BigInt
  group_id        Int
  api_userprofile UserProfile @relation(fields: [userprofile_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_userprofile_grou_userprofile_id_c604c343_fk_api_userp")
  auth_group      auth_group  @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_userprofile_groups_group_id_4bbb714d_fk_auth_group_id")

  @@unique([userprofile_id, group_id], map: "api_userprofile_groups_userprofile_id_group_id_f2d1b2f8_uniq")
  @@index([group_id], map: "api_userprofile_groups_group_id_4bbb714d_fk_auth_group_id")
}

model api_userprofile_user_permissions {
  id              BigInt          @id @default(autoincrement())
  userprofile_id  BigInt
  permission_id   Int
  auth_permission auth_permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_userprofile_user_permission_id_f8a7bcee_fk_auth_perm")
  api_userprofile UserProfile     @relation(fields: [userprofile_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "api_userprofile_user_userprofile_id_6c285edb_fk_api_userp")

  @@unique([userprofile_id, permission_id], map: "api_userprofile_user_per_userprofile_id_permissio_791df516_uniq")
  @@index([permission_id], map: "api_userprofile_user_permission_id_f8a7bcee_fk_auth_perm")
}

model auth_group {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique(map: "name") @db.VarChar(150)
  api_userprofile_groups api_userprofile_groups[]
  auth_group_permissions auth_group_permissions[]
}

model auth_group_permissions {
  id              BigInt          @id @default(autoincrement())
  group_id        Int
  permission_id   Int
  auth_permission auth_permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "auth_group_permissio_permission_id_84c5c92e_fk_auth_perm")
  auth_group      auth_group      @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "auth_group_permissions_group_id_b120cbf9_fk_auth_group_id")

  @@unique([group_id, permission_id], map: "auth_group_permissions_group_id_permission_id_0cd325b0_uniq")
  @@index([permission_id], map: "auth_group_permissio_permission_id_84c5c92e_fk_auth_perm")
}

model auth_permission {
  id                               Int                                @id @default(autoincrement())
  name                             String                             @db.VarChar(255)
  content_type_id                  Int
  codename                         String                             @db.VarChar(100)
  api_userprofile_user_permissions api_userprofile_user_permissions[]
  auth_group_permissions           auth_group_permissions[]
  django_content_type              django_content_type                @relation(fields: [content_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "auth_permission_content_type_id_2f476e4b_fk_django_co")

  @@unique([content_type_id, codename], map: "auth_permission_content_type_id_codename_01ab375a_uniq")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model django_admin_log {
  id                  Int                  @id @default(autoincrement())
  action_time         DateTime             @db.DateTime(6)
  object_id           String?              @db.LongText
  object_repr         String               @db.VarChar(200)
  action_flag         Int                  @db.UnsignedSmallInt
  change_message      String               @db.LongText
  content_type_id     Int?
  user_id             BigInt
  django_content_type django_content_type? @relation(fields: [content_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "django_admin_log_content_type_id_c4bce8eb_fk_django_co")
  api_userprofile     UserProfile          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "django_admin_log_user_id_c564eba6_fk_api_userprofile_id")

  @@index([content_type_id], map: "django_admin_log_content_type_id_c4bce8eb_fk_django_co")
  @@index([user_id], map: "django_admin_log_user_id_c564eba6_fk_api_userprofile_id")
}

model django_content_type {
  id               Int                @id @default(autoincrement())
  app_label        String             @db.VarChar(100)
  model            String             @db.VarChar(100)
  auth_permission  auth_permission[]
  django_admin_log django_admin_log[]

  @@unique([app_label, model], map: "django_content_type_app_label_model_76bd3d3b_uniq")
}

model django_migrations {
  id      BigInt   @id @default(autoincrement())
  app     String   @db.VarChar(255)
  name    String   @db.VarChar(255)
  applied DateTime @db.DateTime(6)
}

model django_session {
  session_key  String   @id @db.VarChar(40)
  session_data String   @db.LongText
  expire_date  DateTime @db.DateTime(6)

  @@index([expire_date], map: "django_session_expire_date_a5c62663")
}

model django_site {
  id     Int    @id @default(autoincrement())
  domain String @unique(map: "django_site_domain_a2e37b91_uniq") @db.VarChar(100)
  name   String @db.VarChar(50)
}
