// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums matching Django choices
enum Role {
  MASTER_ADMIN
  BLOG_ADMIN
  AI_VIDEO_EDITOR_USER
  USER
}

enum SecurityQuestion {
  FIRST_PET
  MOTHER_MAIDEN
  BIRTH_CITY
  FIRST_SCHOOL
  FAVORITE_TEACHER
  CHILDHOOD_FRIEND
  FIRST_CAR
  FAVORITE_PLACE
  PARENTS_MET
  CHILDHOOD_HERO
}

enum UploadedImageStatus {
  PENDING
  USING
}

enum BlogPostStatus {
  draft
  pending
  published
}

// UserProfile corresponds to Django's UserProfile model
model UserProfile {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  firstName        String?           @map("first_name")
  lastName         String?           @map("last_name")
  role             Role              @default(USER)
  isStaff          Boolean           @default(false) @map("is_staff")
  isActive         Boolean           @default(true) @map("is_active")
  dateJoined       DateTime          @default(now()) @map("date_joined")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  isVerified       Boolean           @default(false) @map("is_verified")
  city             String?           @default("")
  state            String?           @default("")
  zipCode          Int?              @default(0) @map("zip_code")
  country          String?           @default("")
  address1         String?           @default("")
  address2         String?           @default("")
  securityQuestion SecurityQuestion? @map("security_question")
  securityAnswer   String?           @map("security_answer")
  profileImage     String?           @map("profile_image")
  phoneNumber      String?           @map("phone_number")
  summery          String?           @map("summery")

  // Relations
  blogCategories BlogCategory[]  @relation("CategoryCreatedBy")
  blogTags       BlogTag[]       @relation("TagCreatedBy")
  uploadedImages UploadedImage[] @relation("UploadedBy")
  blogPosts      BlogPost[]      @relation("AuthorPosts")

  @@map("api_userprofile")
}

// Categories for blogs
model BlogCategory {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  count       Int         @default(1)
  description String?
  createdBy   UserProfile @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  createdById Int
  posts       BlogPost[]  @relation("CategoryPosts")

  @@map("api_blogcategory")
}

// Tags for blogs
model BlogTag {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  count       Int         @default(1)
  createdBy   UserProfile @relation("TagCreatedBy", fields: [createdById], references: [id])
  createdById Int
  posts       BlogPost[]  @relation("PostTags")

  @@map("api_blogtag")
}

model BlogMainPageSections {
  id        Int        @id @default(autoincrement())
  section   String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  posts     BlogPost[] @relation("BlogMainPageSections")

  @@map("api_blogmainpagesections")
}

// Uploaded images
model UploadedImage {
  id               Int                 @id @default(autoincrement())
  name             String?
  image            String
  size             Float               @default(0.0)
  contentType      String?             @map("content_type")
  width            Int                 @default(0)
  height           Int                 @default(0)
  thumbnail        String?
  uploadedAt       DateTime            @default(now()) @map("uploaded_at")
  status           UploadedImageStatus @default(PENDING)
  notificationSent Boolean             @default(false) @map("notification_sent")
  uploadedBy       UserProfile         @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedById     Int                 @map("uploaded_by")

  @@map("api_uploadedimage")
}

// Blog posts
model BlogPost {
  id                Int            @id @default(autoincrement())
  title             String         @unique
  slug              String         @unique
  content           String
  excerpt           String?
  featuredImage     String?        @map("featured_image")
  blogFeaturedImage String?        @map("blog_featured_image")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  publishedAt       DateTime?      @map("published_at")
  status            BlogPostStatus @default(draft)
  metaTitle         String?        @map("meta_title")
  metaDescription   String?        @map("meta_description")
  keywords          String?
  viewCount         Int            @default(0) @map("view_count")
  likeCount         Int            @default(0) @map("like_count")
  isApproved        Int            @default(0) @map("is_approved")
  isFeatured        Int            @default(0) @map("is_featured")

  author          UserProfile           @relation("AuthorPosts", fields: [author_id], references: [id])
  author_id       Int
  category        BlogCategory?         @relation("CategoryPosts", fields: [category_id], references: [id])
  category_id     Int?
  section         BlogMainPageSections? @relation("BlogMainPageSections", fields: [blog_section_id], references: [id])
  blog_section_id Int?
  tags            BlogTag[]             @relation("PostTags")

  @@map("api_blogpost")
}
